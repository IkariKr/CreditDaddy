    end

    subgraph Clients["本机客户端生态"]
        Q["Qoder / Qoder CN"]
        W["WorkBuddy / CodeBuddy"]
        Z["ZCode · mirasim · 妙手 · Trae · MiniMax"]
        BR["浏览器网页会话<br/>登录窗捕获 · 就地重探"]
    end

    Clients --> DETECT
    DETECT --> STORE
    STORE --> SCHED
    SCHED --> QP
    SCHED --> WP
    SCHED --> ZP
    SCHED --> MP
